    {
      "type": "stat",
      "title": "Total spend",
      "description": "Sum of LiteLLM's response_cost for the selected time range, tenants and gateways.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "aegis-influxdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "aegis-influxdb"
          },
          "query": "from(bucket: \"usage\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"llm_usage\" and r._field == \"cost_usd\")\n  |> filter(fn: (r) => r.tenant =~ /^${tenant:regex}$/ and r.gateway =~ /^${gateway:regex}$/)\n  |> group()\n  |> sum()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Spend over time by tenant",
      "description": "Spend per time bucket, stacked: the top of each bar is the total.",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 18,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "aegis-influxdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "aegis-influxdb"
          },
          "query": "from(bucket: \"usage\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"llm_usage\" and r._field == \"cost_usd\")\n  |> filter(fn: (r) => r.tenant =~ /^${tenant:regex}$/ and r.gateway =~ /^${gateway:regex}$/)\n  |> group(columns: [\"tenant\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: sum, createEmpty: true)\n  |> fill(value: 0.0)\n  |> keep(columns: [\"_time\", \"_value\", \"tenant\"])\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"tenant\"], valueColumn: \"_value\")"
        }
