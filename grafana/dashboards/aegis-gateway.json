{
  "uid": "aegis-gateway",
  "title": "Aegis - AI Gateway",
  "description": "Cost, reliability and security of the Aegis AI gateway. Generated by grafana/build_dashboard.py.",
  "tags": [
    "aegis"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "tenant",
        "label": "Tenant",
        "query": "support,engineering,marketing",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "type": "custom",
        "name": "gateway",
        "label": "Gateway",
        "query": "main,sandbox",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "FinOps: what are we spending, and on what?",
