    {
      "type": "timeseries",
      "title": "Error rate by status (%)",
      "description": "Share of requests per bucket that failed: 429 (our budget or a cooled-down model), other 4xx, 5xx.",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "aegis-influxdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "aegis-influxdb"
          },
          "query": "import \"strings\"\nfrom(bucket: \"usage\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"llm_usage\" and r._field == \"prompt_tokens\")\n  |> filter(fn: (r) => r.tenant =~ /^${tenant:regex}$/ and r.gateway =~ /^${gateway:regex}$/)\n  |> map(fn: (r) => ({r with class:\n       if r.status_code == \"429\" then \"e429\"\n       else if strings.hasPrefix(v: r.status_code, prefix: \"4\") then \"e4xx\"\n       else if strings.hasPrefix(v: r.status_code, prefix: \"5\") then \"e5xx\"\n       else \"ok\"}))\n  |> group(columns: [\"class\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: count, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"class\"])\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"class\"], valueColumn: \"_value\")\n  |> map(fn: (r) => {\n       ok = if exists r.ok then r.ok else 0\n       e429 = if exists r.e429 then r.e429 else 0\n       e4xx = if exists r.e4xx then r.e4xx else 0\n       e5xx = if exists r.e5xx then r.e5xx else 0\n       total = float(v: ok + e429 + e4xx + e5xx)\n       return {_time: r._time, \"429\": float(v: e429) / total * 100.0,\n               \"4xx\": float(v: e4xx) / total * 100.0, \"5xx\": float(v: e5xx) / total * 100.0}\n     })"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
