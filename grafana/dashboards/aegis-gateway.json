    {
      "type": "barchart",
      "title": "Spend by model",
      "description": "Which model the money went to (the model that answered, after any fallback).",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "aegis-influxdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "aegis-influxdb"
          },
          "query": "from(bucket: \"usage\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"llm_usage\" and r._field == \"cost_usd\")\n  |> filter(fn: (r) => r.tenant =~ /^${tenant:regex}$/ and r.gateway =~ /^${gateway:regex}$/)\n  |> filter(fn: (r) => r.model_used != \"none\")\n  |> group(columns: [\"model_used\"])\n  |> sum()\n  |> keep(columns: [\"model_used\", \"_value\"])\n  |> group()\n  |> rename(columns: {_value: \"spend\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "xField": "model_used",
        "orientation": "horizontal",
        "showValue": "always",
        "legend": {
          "showLegend": false
        }
      },
      "id": 4
    },
    {
      "type": "gauge",
      "title": "Peak tokens per minute vs quota",
      "description": "The busiest 1-minute bucket of each tenant as a % of its tpm_quota (from tenants.yaml). Near 100% means the tenant is about to be rate-limited.",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "aegis-influxdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "aegis-influxdb"
          },
          "query": "import \"dict\"\nquotas = [\"support\": 50000.0, \"engineering\": 100000.0, \"marketing\": 20000.0]  // tpm_quota per tenant, from tenants.yaml\nfrom(bucket: \"usage\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"llm_usage\" and r._field == \"total_tokens\")\n  |> filter(fn: (r) => r.tenant =~ /^${tenant:regex}$/ and r.gateway =~ /^${gateway:regex}$/)\n  |> filter(fn: (r) => dict.get(dict: quotas, key: r.tenant, default: 0.0) > 0.0)\n  |> group(columns: [\"tenant\"])\n  |> aggregateWindow(every: 1m, fn: sum, createEmpty: false)\n  |> max()\n  |> map(fn: (r) => ({r with _value: float(v: r._value) / dict.get(dict: quotas, key: r.tenant, default: 1.0) * 100.0}))\n  |> map(fn: (r) => ({row: \"total\", tenant: r.tenant, _value: r._value}))\n  |> group()\n  |> pivot(rowKey: [\"row\"], columnKey: [\"tenant\"], valueColumn: \"_value\")\n  |> drop(columns: [\"row\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "custom": {},
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false
      },
      "id": 5
    },
