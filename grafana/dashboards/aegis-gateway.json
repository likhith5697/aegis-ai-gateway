    {
      "type": "timeseries",
      "title": "Latency p50 / p95 by model",
      "description": "Successful requests only, by the model that answered. Dashed = p95.",
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "aegis-influxdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "aegis-influxdb"
          },
          "query": "from(bucket: \"usage\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"llm_usage\" and r._field == \"latency_ms\")\n  |> filter(fn: (r) => r.tenant =~ /^${tenant:regex}$/ and r.gateway =~ /^${gateway:regex}$/)\n  |> filter(fn: (r) => r.status_code == \"200\")\n  |> group(columns: [\"model_used\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: (column, tables=<-) => tables |> quantile(q: 0.5, column: column), createEmpty: false)\n  |> map(fn: (r) => ({r with series: r.model_used + \" p50\"}))\n  |> keep(columns: [\"_time\", \"_value\", \"series\"])\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"series\"], valueColumn: \"_value\")"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "aegis-influxdb"
          },
          "query": "from(bucket: \"usage\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"llm_usage\" and r._field == \"latency_ms\")\n  |> filter(fn: (r) => r.tenant =~ /^${tenant:regex}$/ and r.gateway =~ /^${gateway:regex}$/)\n  |> filter(fn: (r) => r.status_code == \"200\")\n  |> group(columns: [\"model_used\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: (column, tables=<-) => tables |> quantile(q: 0.95, column: column), createEmpty: false)\n  |> map(fn: (r) => ({r with series: r.model_used + \" p95\"}))\n  |> keep(columns: [\"_time\", \"_value\", \"series\"])\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"series\"], valueColumn: \"_value\")"
        }
      ],
      "fieldConfig": {
