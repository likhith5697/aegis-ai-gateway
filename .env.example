# Copy this file to .env and fill in real values. Never commit .env.

# Your Anthropic API key (from console.anthropic.com). LiteLLM uses it to call Claude.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# A password you make up for the gateway. Clients must send it to use the proxy.
# Must start with "sk-".
LITELLM_MASTER_KEY=sk-change-me

# InfluxDB (usage telemetry). Used only the FIRST time InfluxDB starts, to create the
# admin user and token; changing them later has no effect unless you delete its volume.
# Password: at least 8 characters. Token: any long random string, e.g. from
#   docker run --rm python:3.13.16-slim python -c "import secrets; print(secrets.token_urlsafe(32))"
INFLUXDB_ADMIN_PASSWORD=change-me-please
INFLUXDB_ADMIN_TOKEN=change-me-to-a-long-random-token

# Grafana dashboard login (http://localhost:3000). Like InfluxDB's, used on its FIRST start only.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please
# Optional. Port for Grafana on your machine, if 3000 is already used by something else.
# GRAFANA_PORT=3001
# Optional. Only for dashboard screenshots (docker-compose.screenshot.yml): a random string.
# GRAFANA_RENDERER_TOKEN=change-me-to-a-random-string

# Optional. Alert when a tenant spends more than this many USD in the last hour.
# Low by default so the sandbox traffic triggers it; raise it for real use.
# AEGIS_SPEND_ALERT_USD=0.05

# Optional. What to do when a dependency breaks: "open" = allow + warn, "closed" = reject (503).
# AEGIS_RATELIMIT_FAIL_MODE=open     # Redis down
# AEGIS_PII_FAIL_MODE=closed         # PII detector down
